HYDRA_FULL_ERROR=1

SIMULATION_DATA_PATH=/path/to/simulation-data
DIRECTOR_PROJECT_DIR=/path/to/DIRECTOR
ET_DATA_DIR=/path/to/et-data
CCDM_CHECKPOINT_PATH=/path/to/ccdm-code/[2024][EG]Text+keyframe/weight/latest.pth
CCDM_DATA_DIR=/path/to/ccdm-data
GENDOP_CHECKPOINT_PATH=/path/to/LensCraft/third_parties/GenDoP/checkpoints/text_motion.safetensors

CLIP_EMBEDDINGS_CACHE_DIR=./cache
OUTPUT_DIR=./outputs
LOG_DIR=./logs

TEST_CHECKPOINT_PATH=
# The saved training .hydra/config.yaml for the selected LensCraft checkpoint.
TEST_CONFIG_PATH=
# Keep one independent, frozen evaluator fixed across generators and ablations.
# There is no automatic fallback to TEST_CHECKPOINT_PATH.
SEMANTIC_EVALUATOR_CHECKPOINT_PATH=
# Optional saved training .hydra/config.yaml for that evaluator's architecture.
SEMANTIC_EVALUATOR_CONFIG_PATH=
# CLaTr supplies the separate distribution/trajectory-text metric space.
CLATR_NATIVE_CHECKPOINT_PATH=
TEST_OUTPUT_DIR=/path/to/outputs/test
PLOT_SAVE_PATH=./
TSNE_FEATURE_PATH=/path/to/tsne-features

BATCH_DIR=./batch_files
RESULTS_DIR=./batch_results
ANNOTATIONS_DIR=./cinematography_annotations

ET_CIN_LANG_PATH=/path/to/et_cinematography_instructions.json
HF_HOME=/path/to/hf_cache

OPENAI_API_KEY=
